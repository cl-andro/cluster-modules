// zk-pkg — Cluster Package Manager CLI
// Usage: zk-pkg <command> [args]

REGISTRY_URL := "https://raw.githubusercontent.com/cl-andro/cluster-modules/main/index.json"
CACHE_DIR := ".zk_cache"

fn show_usage():
    put "Usage: zk-pkg <command> [args]"
    put ""
    put "Commands:"
    put "  install <package>[@version]    Install a package"
    put "  search <query>                 Search packages"
    put "  list                            List installed packages"
    put "  update                          Update all packages"
    put "  info <package>                 Show package info"
    put "  help                            Show this help"

fn fetch_registry_raw() -> string:
    put "--> Fetching registry..."
    return http_get(REGISTRY_URL)

fn split_at(s: string, delim: string, pos: int) -> string:
    parts := text_split(s, delim)
    if list_size(parts) > pos:
        return parts[pos]
    return ""

fn cmd_install(args):
    if list_size(args) == 0:
        put "Usage: zk-pkg install <package>[@version]"
        return

    pkg_spec := args[0]
    pkg_name := pkg_spec
    pkg_version := "latest"

    at_part := split_at(pkg_spec, "@", 0)
    if at_part != "" and at_part != pkg_spec:
        pkg_name = at_part
        pkg_version = split_at(pkg_spec, "@", 1)

    put "--> Installing " + pkg_name + " (" + pkg_version + ")..."

    registry_json := fetch_registry_raw()
    pkg_entry := json_get(registry_json, pkg_name)

    if pkg_entry == "" or string_contains(pkg_entry, "Error"):
        put "Error: Package '" + pkg_name + "' not found"
        return

    pkg_url := "https://raw.githubusercontent.com/cl-andro/cluster-modules/main/packages/" + pkg_name + "/main.zk"
    put "--> Downloading from " + pkg_url

    source := http_get(pkg_url)
    if source == "":
        put "Error: Failed to download package source"
        return

    os_run("mkdir -p " + CACHE_DIR)
    cache_path := CACHE_DIR + "/" + pkg_name + ".zk"
    file_write(cache_path, source)
    put "--> Installed " + pkg_name + " to " + cache_path

fn cmd_search(args):
    if list_size(args) == 0:
        put "Usage: zk-pkg search <query>"
        return

    query := args[0]
    registry_json := fetch_registry_raw()
    put "Searching for '" + query + "'..."
    put registry_json

fn cmd_list(args):
    put "Installed packages:"
    os_run("ls -la " + CACHE_DIR + " 2>/dev/null || echo '(none)'")

fn cmd_info(args):
    if list_size(args) == 0:
        put "Usage: zk-pkg info <package>"
        return

    pkg_name := args[0]
    registry_json := fetch_registry_raw()
    pkg_entry := json_get(registry_json, pkg_name)

    if pkg_entry == "" or string_contains(pkg_entry, "Error"):
        put "Error: Package '" + pkg_name + "' not found"
        return

    put pkg_name + ":"
    put "  " + pkg_entry

fn main():
    args := sys_args
    if list_size(args) == 0:
        show_usage()
        return

    cmd := args[0]

    if cmd == "install":
        cmd_install(text_rest(args, 1))
    elif cmd == "search":
        cmd_search(text_rest(args, 1))
    elif cmd == "list":
        cmd_list(text_rest(args, 1))
    elif cmd == "info":
        cmd_info(text_rest(args, 1))
    elif cmd == "update":
        put "Update command coming soon"
    elif cmd == "help" or cmd == "--help" or cmd == "-h":
        show_usage()
    else:
        put "Unknown command: " + cmd
        show_usage()
