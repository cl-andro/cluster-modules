// cl-levenshtein: Levenshtein Distance Calculation Engine

fn distance(s1: string, s2: string) -> int:
    dist := 0
    unsafe:
        cpp_inject "int len1 = s1.size();"
        cpp_inject "int len2 = s2.size();"
        cpp_inject "std::vector<int> col(len2 + 1), prevCol(len2 + 1);"
        cpp_inject "for (int i = 0; i <= len2; i++) prevCol[i] = i;"
        cpp_inject "for (int i = 0; i < len1; i++) {"
        cpp_inject "    col[0] = i + 1;"
        cpp_inject "    for (int j = 0; j < len2; j++) {"
        cpp_inject "        int cost = (s1[i] == s2[j]) ? 0 : 1;"
        cpp_inject "        col[j + 1] = std::min({prevCol[j + 1] + 1, col[j] + 1, prevCol[j] + cost});"
        cpp_inject "    }"
        cpp_inject "    prevCol = col;"
        cpp_inject "}"
        cpp_inject "dist = prevCol[len2];"
    return dist
