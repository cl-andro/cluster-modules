cpp_inject "#include <random>"
cpp_inject "#include <algorithm>"
cpp_inject "#include <ctime>"

cpp_inject "static std::mt19937 _rng(std::time(0));"

fn seed(value: int):
    cpp_inject "_rng.seed(value);"

fn randint(min: int, max: int) -> int:
    result := 0
    cpp_inject "std::uniform_int_distribution<int> dist(min, max);"
    cpp_inject "result = dist(_rng);"
    return result

fn randfloat(min: float, max: float) -> float:
    result := 0.0
    cpp_inject "std::uniform_real_distribution<double> dist(min, max);"
    cpp_inject "result = dist(_rng);"
    return result

fn choice(input_list: vector[string]) -> string:
    res := ""
    unsafe:
        cpp_inject "if (!input_list.empty()) res = input_list.at(rand() % input_list.size());"
    return res

fn shuffle(input_list: vector[string]) -> vector[string]:
    result := input_list
    unsafe:
        cpp_inject "std::random_device rd;"
        cpp_inject "std::mt19937 g(rd());"
        cpp_inject "std::shuffle(result.begin(), result.end(), g);"
    return result

fn weighted(weights: vector[float]) -> int:
    idx := -1
    unsafe:
        cpp_inject "double total = 0.0;"
        cpp_inject "for (double w : weights) total += w;"
        cpp_inject "double r = ((double)rand() / RAND_MAX) * total;"
        cpp_inject "double cumulative = 0.0;"
        cpp_inject "for (size_t i = 0; i < weights.size(); ++i) {"
        cpp_inject "    cumulative += weights[i];"
        cpp_inject "    if (r <= cumulative) { idx = (int)i; break; }"
        cpp_inject "}"
        cpp_inject "if (idx == -1 && !weights.empty()) idx = (int)weights.size() - 1;"
    return idx
