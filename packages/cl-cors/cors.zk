// cl-cors: Cross-Origin Resource Sharing (CORS) Middleware Engine

fn cors_headers(origin: string, methods: string):
    cpp_inject "std::vector<std::string> h;"
    allow_origin := origin
    if allow_origin == "":
        allow_origin = "*"
    allow_methods := methods
    if allow_methods == "":
        allow_methods = "GET, POST, PUT, DELETE, OPTIONS"
    cpp_inject "h.push_back(\"Access-Control-Allow-Origin: \" + allow_origin);"
    cpp_inject "h.push_back(\"Access-Control-Allow-Methods: \" + allow_methods);"
    cpp_inject "h.push_back(\"Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With\");"
    return h
