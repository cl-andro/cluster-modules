# HTTP Client Module
# Wraps the native http_get/http_post functions

fn get(url: string, headers: [string]) -> string:
    return http_get(url, headers)

fn post(url: string, body: string, headers: [string]) -> string:
    return http_post(url, body, headers)

fn get_json(url: string) -> string:
    response := http_get(url, ["Accept: application/json"])
    return json_parse(response)

fn post_json(url: string, data: string) -> string:
    response := http_post(url, data, ["Content-Type: application/json"])
    return json_parse(response)

# Download file to disk
fn download(url: string, dest: string) -> bool:
    data := http_get(url, [])
    if data == "":
        return false
    file_write(dest, data)
    return true
