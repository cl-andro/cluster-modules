// cl-hmac: HMAC-SHA256 Generator Engine

fn sha256_hmac(key: string, message: string) -> string:
    res: string := ""
    unsafe:
        cpp_inject "std::string k = key;"
        cpp_inject "if (k.length() > 64) {"
        cpp_inject "    std::string kh = crypto_hash(k);"
        cpp_inject "    k = \"\";"
        cpp_inject "    for (size_t i = 0; i < kh.length(); i += 2) {"
        cpp_inject "        k.push_back((char)(int)strtol(kh.substr(i, 2).c_str(), NULL, 16));"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "if (k.length() < 64) k.append(64 - k.length(), 0x00);"
        cpp_inject "std::string ipad(64, 0x36);"
        cpp_inject "std::string opad(64, 0x5c);"
        cpp_inject "for (int i = 0; i < 64; ++i) {"
        cpp_inject "    ipad[i] ^= k[i];"
        cpp_inject "    opad[i] ^= k[i];"
        cpp_inject "}"
        cpp_inject "std::string inner_hex = crypto_hash(ipad + message);"
        cpp_inject "std::string inner_bytes;"
        cpp_inject "for (size_t i = 0; i < inner_hex.length(); i += 2) {"
        cpp_inject "    inner_bytes.push_back((char)(int)strtol(inner_hex.substr(i, 2).c_str(), NULL, 16));"
        cpp_inject "}"
        cpp_inject "res = crypto_hash(opad + inner_bytes);"
    return res
