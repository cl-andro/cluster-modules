// Subprocess module (wraps popen)
cpp_inject "#include <cstdio>"
cpp_inject "#include <memory>"
cpp_inject "#include <array>"

fn run(cmd: string) -> string:
    return os_run(cmd)

fn run_split(args: vector[string]) -> string:
    cmd: string := ""
    for arg in args:
        if cmd != "":
            cmd = cmd + " "
        cmd = cmd + arg
    return os_run(cmd)

fn run_bg(cmd: string) -> int:
    result := -1
    unsafe:
        cpp_inject "result = system((cmd + \" &>/dev/null &\").c_str());"
    return result

fn output_lines(cmd: string) -> vector[string]:
    result := vector[string]()
    cpp_inject "std::array<char, 128> buf;"
    cpp_inject "std::unique_ptr<FILE, decltype(&pclose)> pipe(popen(cmd.c_str(), \"r\"), pclose);"
    cpp_inject "if (pipe) {"
    cpp_inject "    while (fgets(buf.data(), buf.size(), pipe.get())) {"
    cpp_inject "        string line(buf.data());"
    cpp_inject "        if (!line.empty() && line.back() == '\\n') line.pop_back();"
    cpp_inject "        result.push_back(line);"
    cpp_inject "    }"
    cpp_inject "}"
    return result

fn exists(cmd: string) -> bool:
    result := false
    unsafe:
        cpp_inject "result = (system((\"which \" + cmd + \" > /dev/null 2>&1\").c_str()) == 0);"
    return result
