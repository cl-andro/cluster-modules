// cl-json2: JSON Pretty Printer Engine

fn pretty_print(s: string) -> string:
    res := ""
    unsafe:
        cpp_inject "std::string out;"
        cpp_inject "int indent = 0;"
        cpp_inject "bool in_quotes = false;"
        cpp_inject "for (size_t i = 0; i < s.size(); ++i) {"
        cpp_inject "    char c = s[i];"
        cpp_inject "    if (c == '\"' && (i == 0 || s[i-1] != '\\\\')) {"
        cpp_inject "        in_quotes = !in_quotes;"
        cpp_inject "        out.push_back(c);"
        cpp_inject "    } else if (in_quotes) {"
        cpp_inject "        out.push_back(c);"
        cpp_inject "    } else if (c == '{' || c == '[') {"
        cpp_inject "        out.push_back(c);"
        cpp_inject "        out.push_back('\\n');"
        cpp_inject "        indent += 2;"
        cpp_inject "        out.append(indent, ' ');"
        cpp_inject "    } else if (c == '}' || c == ']') {"
        cpp_inject "        out.push_back('\\n');"
        cpp_inject "        indent -= 2;"
        cpp_inject "        if (indent < 0) indent = 0;"
        cpp_inject "        out.append(indent, ' ');"
        cpp_inject "        out.push_back(c);"
        cpp_inject "    } else if (c == ',') {"
        cpp_inject "        out.push_back(c);"
        cpp_inject "        out.push_back('\\n');"
        cpp_inject "        out.append(indent, ' ');"
        cpp_inject "    } else if (c == ':') {"
        cpp_inject "        out.push_back(c);"
        cpp_inject "        out.push_back(' ');"
        cpp_inject "    } else if (c != ' ' && c != '\\n' && c != '\\r' && c != '\\t') {"
        cpp_inject "        out.push_back(c);"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "res = out;"
    return res
