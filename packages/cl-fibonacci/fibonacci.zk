// cl-fibonacci: Fibonacci Sequence Generator Engine

fn nth(n: int) -> int:
    res := 0
    unsafe:
        cpp_inject "if (n <= 0) res = 0;"
        cpp_inject "else if (n == 1) res = 1;"
        cpp_inject "else {"
        cpp_inject "    long long a = 0, b = 1, c = 0;"
        cpp_inject "    for (int i = 2; i <= n; ++i) {"
        cpp_inject "        c = a + b;"
        cpp_inject "        a = b;"
        cpp_inject "        b = c;"
        cpp_inject "    }"
        cpp_inject "    res = b;"
        cpp_inject "}"
    return res
