// cl-env: OS Environment Configuration Parser Engine

fn get(name: string, default_val: string) -> string:
    res := default_val
    unsafe:
        cpp_inject "char* val = std::getenv(name.c_str());"
        cpp_inject "if (val != nullptr) res = std::string(val);"
    return res

fn get_int(name: string, default_val: int) -> int:
    res := default_val
    unsafe:
        cpp_inject "char* val = std::getenv(name.c_str());"
        cpp_inject "if (val != nullptr) {"
        cpp_inject "    res = std::stoll(val);"
        cpp_inject "}"
    return res

fn get_bool(name: string, default_val: bool) -> bool:
    res := default_val
    unsafe:
        cpp_inject "char* val = std::getenv(name.c_str());"
        cpp_inject "if (val != nullptr) {"
        cpp_inject "    std::string s(val);"
        cpp_inject "    res = (s == \"1\" || s == \"true\" || s == \"yes\" || s == \"on\");"
        cpp_inject "}"
    return res
