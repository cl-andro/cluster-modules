// cl-csv2: CSV Writer and Serializer Engine

fn write_row(fields: vector[string]) -> string:
    res := ""
    unsafe:
        cpp_inject "std::string row;"
        cpp_inject "for (size_t i = 0; i < fields.size(); ++i) {"
        cpp_inject "    std::string f = fields[i];"
        cpp_inject "    bool need_quotes = false;"
        cpp_inject "    if (f.find(',') != std::string::npos || f.find('\"') != std::string::npos || f.find('\\n') != std::string::npos || f.find('\\r') != std::string::npos) {"
        cpp_inject "        need_quotes = true;"
        cpp_inject "    }"
        cpp_inject "    if (need_quotes) {"
        cpp_inject "        row += '\"';"
        cpp_inject "        for (char c : f) {"
        cpp_inject "            if (c == '\"') { row += '\"'; row += '\"'; }"
        cpp_inject "            else row += c;"
        cpp_inject "        }"
        cpp_inject "        row += '\"';"
        cpp_inject "    } else {"
        cpp_inject "        row += f;"
        cpp_inject "    }"
        cpp_inject "    if (i < fields.size() - 1) row += ',';"
        cpp_inject "}"
        cpp_inject "row += \"\\n\";"
        cpp_inject "res = row;"
    return res
