// cl-crc8: CRC-8 Checksum Hashing Engine

fn checksum(s: string) -> int:
    res := 0
    unsafe:
        cpp_inject "unsigned char crc = 0x00;"
        cpp_inject "for (char c : s) {"
        cpp_inject "    crc ^= (unsigned char)c;"
        cpp_inject "    for (int i = 0; i < 8; ++i) {"
        cpp_inject "        if (crc & 0x80) crc = (crc << 1) ^ 0x07;"
        cpp_inject "        else crc <<= 1;"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "res = crc;"
    return res
