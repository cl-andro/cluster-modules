// cl-playfair: Playfair Cipher Engine

fn encode(payload: string, key: string) -> string:
    res := ""
    unsafe:
        cpp_inject "std::string matrix_chars;"
        cpp_inject "bool present[26] = {false};"
        cpp_inject "present['J' - 'A'] = true;" // Treat J as I
        cpp_inject "for (char c : key) {"
        cpp_inject "    char uc = std::toupper((unsigned char)c);"
        cpp_inject "    if (std::isalpha((unsigned char)c)) {"
        cpp_inject "        if (uc == 'J') uc = 'I';"
        cpp_inject "        if (!present[uc - 'A']) {"
        cpp_inject "            matrix_chars += uc;"
        cpp_inject "            present[uc - 'A'] = true;"
        cpp_inject "        }"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "for (int i = 0; i < 26; ++i) {"
        cpp_inject "    if (!present[i]) {"
        cpp_inject "        matrix_chars += (char)('A' + i);"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "char matrix[5][5];"
        cpp_inject "int pos_r[26], pos_c[26];"
        cpp_inject "for (int i = 0; i < 25; ++i) {"
        cpp_inject "    matrix[i / 5][i % 5] = matrix_chars[i];"
        cpp_inject "    pos_r[matrix_chars[i] - 'A'] = i / 5;"
        cpp_inject "    pos_c[matrix_chars[i] - 'A'] = i % 5;"
        cpp_inject "}"
        cpp_inject "pos_r['J' - 'A'] = pos_r['I' - 'A'];"
        cpp_inject "pos_c['J' - 'A'] = pos_c['I' - 'A'];"
        cpp_inject "std::string clean_p;"
        cpp_inject "for (char c : payload) {"
        cpp_inject "    if (std::isalpha((unsigned char)c)) {"
        cpp_inject "        char uc = std::toupper((unsigned char)c);"
        cpp_inject "        if (uc == 'J') uc = 'I';"
        cpp_inject "        clean_p += uc;"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "std::string digraphs;"
        cpp_inject "for (size_t i = 0; i < clean_p.size(); ) {"
        cpp_inject "    char c1 = clean_p[i++];"
        cpp_inject "    char c2 = 'X';"
        cpp_inject "    if (i < clean_p.size()) {"
        cpp_inject "        if (clean_p[i] != c1) c2 = clean_p[i++];"
        cpp_inject "    }"
        cpp_inject "    digraphs += c1;"
        cpp_inject "    digraphs += c2;"
        cpp_inject "}"
        cpp_inject "std::string out;"
        cpp_inject "for (size_t i = 0; i < digraphs.size(); i += 2) {"
        cpp_inject "    char c1 = digraphs[i], c2 = digraphs[i + 1];"
        cpp_inject "    int r1 = pos_r[c1 - 'A'], c_1 = pos_c[c1 - 'A'];"
        cpp_inject "    int r2 = pos_r[c2 - 'A'], c_2 = pos_c[c2 - 'A'];"
        cpp_inject "    if (r1 == r2) {"
        cpp_inject "        out += matrix[r1][(c_1 + 1) % 5];"
        cpp_inject "        out += matrix[r2][(c_2 + 1) % 5];"
        cpp_inject "    } else if (c_1 == c_2) {"
        cpp_inject "        out += matrix[(r1 + 1) % 5][c_1];"
        cpp_inject "        out += matrix[(r2 + 1) % 5][c_2];"
        cpp_inject "    } else {"
        cpp_inject "        out += matrix[r1][c_2];"
        cpp_inject "        out += matrix[r2][c_1];"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "res = out;"
    return res

fn decode(payload: string, key: string) -> string:
    res := ""
    unsafe:
        cpp_inject "std::string matrix_chars;"
        cpp_inject "bool present[26] = {false};"
        cpp_inject "present['J' - 'A'] = true;"
        cpp_inject "for (char c : key) {"
        cpp_inject "    char uc = std::toupper((unsigned char)c);"
        cpp_inject "    if (std::isalpha((unsigned char)c)) {"
        cpp_inject "        if (uc == 'J') uc = 'I';"
        cpp_inject "        if (!present[uc - 'A']) {"
        cpp_inject "            matrix_chars += uc;"
        cpp_inject "            present[uc - 'A'] = true;"
        cpp_inject "        }"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "for (int i = 0; i < 26; ++i) {"
        cpp_inject "    if (!present[i]) matrix_chars += (char)('A' + i);"
        cpp_inject "}"
        cpp_inject "char matrix[5][5];"
        cpp_inject "int pos_r[26], pos_c[26];"
        cpp_inject "for (int i = 0; i < 25; ++i) {"
        cpp_inject "    matrix[i / 5][i % 5] = matrix_chars[i];"
        cpp_inject "    pos_r[matrix_chars[i] - 'A'] = i / 5;"
        cpp_inject "    pos_c[matrix_chars[i] - 'A'] = i % 5;"
        cpp_inject "}"
        cpp_inject "pos_r['J' - 'A'] = pos_r['I' - 'A'];"
        cpp_inject "pos_c['J' - 'A'] = pos_c['I' - 'A'];"
        cpp_inject "std::string out;"
        cpp_inject "for (size_t i = 0; i < payload.size(); i += 2) {"
        cpp_inject "    if (i + 1 >= payload.size()) break;"
        cpp_inject "    char c1 = payload[i], c2 = payload[i + 1];"
        cpp_inject "    int r1 = pos_r[c1 - 'A'], c_1 = pos_c[c1 - 'A'];"
        cpp_inject "    int r2 = pos_r[c2 - 'A'], c_2 = pos_c[c2 - 'A'];"
        cpp_inject "    if (r1 == r2) {"
        cpp_inject "        out += matrix[r1][(c_1 + 4) % 5];"
        cpp_inject "        out += matrix[r2][(c_2 + 4) % 5];"
        cpp_inject "    } else if (c_1 == c_2) {"
        cpp_inject "        out += matrix[(r1 + 4) % 5][c_1];"
        cpp_inject "        out += matrix[(r2 + 4) % 5][c_2];"
        cpp_inject "    } else {"
        cpp_inject "        out += matrix[r1][c_2];"
        cpp_inject "        out += matrix[r2][c_1];"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "res = out;"
    return res
