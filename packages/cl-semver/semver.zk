cpp_inject("#include <string>")
cpp_inject("#include <vector>")
cpp_inject("#include <sstream>")
cpp_inject("#include <cstdlib>")

model Version
    major := 0
    minor := 0
    patch := 0
    pre_release := ""
    build := ""

fn parse(version_str)
    v := Version{}
    cpp_inject("""
        std::string s = version_str;
        std::istringstream ss(s);
        std::string token;
        std::getline(ss, token, '.');
        v.major = std::atoi(token.c_str());
        std::getline(ss, token, '.');
        v.minor = std::atoi(token.c_str());
        std::getline(ss, token, '.');
        size_t dash = token.find('-');
        size_t plus = token.find('+');
        if (dash != std::string::npos) {
            v.patch = std::atoi(token.substr(0, dash).c_str());
            size_t end = (plus != std::string::npos) ? plus : token.size();
            v.pre_release = token.substr(dash + 1, end - dash - 1);
        } else if (plus != std::string::npos) {
            v.patch = std::atoi(token.substr(0, plus).c_str());
            v.build = token.substr(plus + 1);
        } else {
            v.patch = std::atoi(token.c_str());
        }
        if (plus != std::string::npos && dash == std::string::npos) {}
        size_t build_part = s.find('+');
        if (build_part != std::string::npos && dash != std::string::npos && build_part > dash) {
            v.build = s.substr(build_part + 1);
        } else if (build_part != std::string::npos && dash == std::string::npos) {
        }
    """)
    return v

fn to_string(v)
    result := ""
    cpp_inject("""
        result = std::to_string(v.major) + "." + std::to_string(v.minor) + "." + std::to_string(v.patch);
        if (!v.pre_release.empty()) result += "-" + v.pre_release;
        if (!v.build.empty()) result += "+" + v.build;
    """)
    return result

fn compare(a, b)
    if a.major < b.major
        return -1
    if a.major > b.major
        return 1
    if a.minor < b.minor
        return -1
    if a.minor > b.minor
        return 1
    if a.patch < b.patch
        return -1
    if a.patch > b.patch
        return 1
    if a.pre_release == "" and b.pre_release != ""
        return 1
    if a.pre_release != "" and b.pre_release == ""
        return -1
    if a.pre_release < b.pre_release
        return -1
    if a.pre_release > b.pre_release
        return 1
    return 0

fn satisfies(v, range)
    prefix := range[0]
    rest := ""
    cpp_inject("rest = range.substr(1);")
    parts := list()
    cpp_inject("""
        std::istringstream ss(rest);
        std::string token;
        while (std::getline(ss, token, '.')) {
            list_push(parts, token);
        }
    """)
    if prefix == "^"
        maj := 0
        cpp_inject("maj = std::atoi(((std::string)parts[0]).c_str());")
        if list_size(parts) > 1
            min := 0
            cpp_inject("min = std::atoi(((std::string)parts[1]).c_str());")
            return v.major == maj and v.minor >= min
        return v.major == maj
    if prefix == "~"
        maj := 0
        min := 0
        cpp_inject("""
            maj = std::atoi(((std::string)parts[0]).c_str());
            min = std::atoi(((std::string)parts[1]).c_str());
        """)
        return v.major == maj and v.minor == min
    return 0

fn bump_major(v)
    v.major := v.major + 1
    v.minor := 0
    v.patch := 0
    v.pre_release := ""
    v.build := ""
    return v

fn bump_minor(v)
    v.minor := v.minor + 1
    v.patch := 0
    v.pre_release := ""
    v.build := ""
    return v

fn bump_patch(v)
    v.patch := v.patch + 1
    v.pre_release := ""
    v.build := ""
    return v
