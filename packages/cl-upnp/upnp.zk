// cl-upnp: UPnP Port Forwarding Engine
import cl-http as http

fn add_port_mapping(router_soap_url: string, local_ip: string, external_port: int, local_port: int, protocol: string) -> string:
    soap_body := "<?xml version=\"1.0\"?>\r\n"
    soap_body = soap_body + "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\">\r\n"
    soap_body = soap_body + "  <s:Body>\r\n"
    soap_body = soap_body + "    <u:AddPortMapping xmlns:u=\"urn:schemas-upnp-org:service:WANIPConnection:1\">\r\n"
    soap_body = soap_body + "      <NewRemoteHost></NewRemoteHost>\r\n"
    soap_body = soap_body + "      <NewExternalPort>" + str(external_port) + "</NewExternalPort>\r\n"
    soap_body = soap_body + "      <NewProtocol>" + protocol + "</NewProtocol>\r\n"
    soap_body = soap_body + "      <NewInternalPort>" + str(local_port) + "</NewInternalPort>\r\n"
    soap_body = soap_body + "      <NewInternalClient>" + local_ip + "</NewInternalClient>\r\n"
    soap_body = soap_body + "      <NewEnabled>1</NewEnabled>\r\n"
    soap_body = soap_body + "      <NewPortMappingDescription>ClusterUPnP</NewPortMappingDescription>\r\n"
    soap_body = soap_body + "      <NewLeaseDuration>0</NewLeaseDuration>\r\n"
    soap_body = soap_body + "    </u:AddPortMapping>\r\n"
    soap_body = soap_body + "  </s:Body>\r\n"
    soap_body = soap_body + "</s:Envelope>"
    
    return http::post_json(router_soap_url, soap_body)
