// cl-config: Configuration File Reader
// Supports JSON and INI format parsing into flat key-value maps

model Config
    data := map_new()

fn load_json(path)
    cfg := Config{}
    cfg.data := map_new()
    text := file_read(path)
    parsed := json_parse(text)
    keys := json_keys(parsed)
    i := 0
    while i < list_size(keys)
        key := keys[i]
        value := json_get(parsed, key)
        map_set(cfg.data, key, value)
        i := i + 1
    return cfg

fn load_ini(path)
    cfg := Config{}
    cfg.data := map_new()
    text := file_read(path)
    lines := text_split(text, "\n")
    section := ""
    i := 0
    while i < list_size(lines)
        line := string_trim(lines[i])
        if line != "" and string_starts_with(line, ";") == 0 and string_starts_with(line, "#") == 0
            if string_starts_with(line, "[")
                section := text_replace(line, "[", "")
                section = text_replace(section, "]", "")
            else
                eq_parts := text_split(line, "=")
                if list_size(eq_parts) == 2
                    key := string_trim(eq_parts[0])
                    value := string_trim(eq_parts[1])
                    if section != ""
                        key = section + "." + key
                    map_set(cfg.data, key, value)
        i := i + 1
    return cfg

fn get(cfg, key)
    if map_has(cfg.data, key)
        return map_get(cfg.data, key)
    return ""

fn get_int(cfg, key)
    if map_has(cfg.data, key)
        cpp_inject("return std::atoi(map_get(cfg.data, key).c_str());")
    return 0

fn get_bool(cfg, key)
    if map_has(cfg.data, key)
        val := map_get(cfg.data, key)
        if val == "true" or val == "1" or val == "yes"
            return 1
    return 0

fn has(cfg, key)
    return map_has(cfg.data, key)
