// cl-cosine-similarity: Cosine Similarity Metric Engine

fn similarity(v1: vector[float], v2: vector[float]) -> float:
    res := 0.0
    unsafe:
        cpp_inject "if (v1.size() == v2.size() && !v1.empty()) {"
        cpp_inject "    double dot = 0.0, mag1 = 0.0, mag2 = 0.0;"
        cpp_inject "    for (size_t i = 0; i < v1.size(); ++i) {"
        cpp_inject "        dot += v1[i] * v2[i];"
        cpp_inject "        mag1 += v1[i] * v1[i];"
        cpp_inject "        mag2 += v2[i] * v2[i];"
        cpp_inject "    }"
        cpp_inject "    if (mag1 > 0 && mag2 > 0) {"
        cpp_inject "        res = dot / (std::sqrt(mag1) * std::sqrt(mag2));"
        cpp_inject "    }"
        cpp_inject "}"
    return res
