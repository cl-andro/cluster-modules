// Base64 Encoding/Decoding Module

fn encode(data: string) -> string:
    result := ""
    cpp_inject "static const char chars[] = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";"
    cpp_inject "std::string in = data;"
    cpp_inject "std::string out;"
    cpp_inject "int val = 0, valb = -6;"
    cpp_inject "for (unsigned char c : in) { val = (val << 8) + c; valb += 8; while (valb >= 0) { out.push_back(chars[(val >> valb) & 0x3F]); valb -= 6; } }"
    cpp_inject "if (valb > -6) out.push_back(chars[((val << 8) >> (valb + 8)) & 0x3F]);"
    cpp_inject "while (out.size() % 4) out.push_back('=');"
    cpp_inject "result = out;"
    return result

fn decode(data: string) -> string:
    result := ""
    cpp_inject "std::string in = data;"
    cpp_inject "std::string out;"
    cpp_inject "std::vector<int> T(256, -1);"
    cpp_inject "for (int i = 0; i < 64; i++) T[\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"[i]] = i;"
    cpp_inject "int val = 0, valb = -8;"
    cpp_inject "for (unsigned char c : in) { if (T[c] == -1) break; val = (val << 6) + T[c]; valb += 6; if (valb >= 0) { out.push_back(char((val >> valb) & 0xFF)); valb -= 8; } }"
    cpp_inject "result = out;"
    return result
