// cl-base91: Base91 Encoding and Decoding Engine

fn encode(s: string) -> string:
    res := ""
    unsafe:
        cpp_inject "static const char* ALPHABET = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&()*+,./:;<=>?@[]^_`{|}~\";"
        cpp_inject "std::string out;"
        cpp_inject "unsigned long queue = 0;"
        cpp_inject "unsigned int nbits = 0;"
        cpp_inject "for (char c : s) {"
        cpp_inject "    queue |= ((unsigned long)(unsigned char)c) << nbits;"
        cpp_inject "    nbits += 8;"
        cpp_inject "    if (nbits > 13) {"
        cpp_inject "        unsigned int val = queue & 8191;"
        cpp_inject "        if (val > 88) {"
        cpp_inject "            queue >>= 13;"
        cpp_inject "            nbits -= 13;"
        cpp_inject "        } else {"
        cpp_inject "            val = queue & 16383;"
        cpp_inject "            queue >>= 14;"
        cpp_inject "            nbits -= 14;"
        cpp_inject "        }"
        cpp_inject "        out += ALPHABET[val % 91];"
        cpp_inject "        out += ALPHABET[val / 91];"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "if (nbits > 0) {"
        cpp_inject "    out += ALPHABET[queue % 91];"
        cpp_inject "    if (nbits > 7 || queue > 90) {"
        cpp_inject "        out += ALPHABET[queue / 91];"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "res = out;"
    return res
