cpp_inject("#include <string>")

fn red(text)
    cpp_inject("return \"\\033[31m\" + text + \"\\033[0m\";")

fn green(text)
    cpp_inject("return \"\\033[32m\" + text + \"\\033[0m\";")

fn yellow(text)
    cpp_inject("return \"\\033[33m\" + text + \"\\033[0m\";")

fn blue(text)
    cpp_inject("return \"\\033[34m\" + text + \"\\033[0m\";")

fn magenta(text)
    cpp_inject("return \"\\033[35m\" + text + \"\\033[0m\";")

fn cyan(text)
    cpp_inject("return \"\\033[36m\" + text + \"\\033[0m\";")

fn white(text)
    cpp_inject("return \"\\033[37m\" + text + \"\\033[0m\";")

fn bold(text)
    cpp_inject("return \"\\033[1m\" + text + \"\\033[0m\";")

fn dim(text)
    cpp_inject("return \"\\033[2m\" + text + \"\\033[0m\";")

fn italic(text)
    cpp_inject("return \"\\033[3m\" + text + \"\\033[0m\";")

fn underline(text)
    cpp_inject("return \"\\033[4m\" + text + \"\\033[0m\";")

fn reset()
    cpp_inject("return \"\\033[0m\";")
