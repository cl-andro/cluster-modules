// cl-ansi: ANSI Terminal Color Formatter Engine

fn red(s: string) -> string:
    res := ""
    unsafe:
        cpp_inject "res = \"\\033[31m\" + s + \"\\033[0m\";"
    return res

fn green(s: string) -> string:
    res := ""
    unsafe:
        cpp_inject "res = \"\\033[32m\" + s + \"\\033[0m\";"
    return res

fn yellow(s: string) -> string:
    res := ""
    unsafe:
        cpp_inject "res = \"\\033[33m\" + s + \"\\033[0m\";"
    return res

fn blue(s: string) -> string:
    res := ""
    unsafe:
        cpp_inject "res = \"\\033[34m\" + s + \"\\033[0m\";"
    return res

fn bold(s: string) -> string:
    res := ""
    unsafe:
        cpp_inject "res = \"\\033[1m\" + s + \"\\033[0m\";"
    return res
