// cl-base58-check: Base58Check Encoding and Decoding Engine

fn encode(payload: string) -> string:
    res := ""
    unsafe:
        cpp_inject "static const char* ALPHABET = \"123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz\";"
        cpp_inject "unsigned int cksum = 0;"
        cpp_inject "for (char c : payload) cksum += (unsigned char)c;"
        cpp_inject "std::string data_bytes = payload;"
        cpp_inject "for (int i = 3; i >= 0; --i) {"
        cpp_inject "    data_bytes += (char)((cksum >> (i * 8)) & 0xFF);"
        cpp_inject "}"
        cpp_inject "std::string out;"
        cpp_inject "long long zero_count = 0;"
        cpp_inject "for (char c : data_bytes) {"
        cpp_inject "    if (c == 0) zero_count++;"
        cpp_inject "    else break;"
        cpp_inject "}"
        cpp_inject "std::vector<unsigned char> digits;"
        cpp_inject "for (char c : data_bytes) {"
        cpp_inject "    int carry = (unsigned char)c;"
        cpp_inject "    for (auto& d : digits) {"
        cpp_inject "        int temp = d * 256 + carry;"
        cpp_inject "        d = temp % 58;"
        cpp_inject "        carry = temp / 58;"
        cpp_inject "    }"
        cpp_inject "    while (carry > 0) {"
        cpp_inject "        digits.push_back(carry % 58);"
        cpp_inject "        carry /= 58;"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "for (long long i = 0; i < zero_count; ++i) out += '1';"
        cpp_inject "std::reverse(digits.begin(), digits.end());"
        cpp_inject "for (auto d : digits) out += ALPHABET[d];"
        cpp_inject "res = out;"
    return res

fn decode(s: string) -> string:
    res := ""
    unsafe:
        cpp_inject "static const std::string ALPHABET = \"123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz\";"
        cpp_inject "std::vector<unsigned char> bytes;"
        cpp_inject "long long zero_count = 0;"
        cpp_inject "for (char c : s) {"
        cpp_inject "    if (c == '1') zero_count++;"
        cpp_inject "    else break;"
        cpp_inject "}"
        cpp_inject "for (char c : s) {"
        cpp_inject "    size_t idx = ALPHABET.find(c);"
        cpp_inject "    if (idx == std::string::npos) continue;"
        cpp_inject "    int carry = idx;"
        cpp_inject "    for (auto& b : bytes) {"
        cpp_inject "        int temp = b * 58 + carry;"
        cpp_inject "        b = temp & 0xFF;"
        cpp_inject "        carry = temp >> 8;"
        cpp_inject "    }"
        cpp_inject "    while (carry > 0) {"
        cpp_inject "        bytes.push_back(carry & 0xFF);"
        cpp_inject "        carry >>= 8;"
        cpp_inject "    }"
        cpp_inject "}"
        cpp_inject "std::reverse(bytes.begin(), bytes.end());"
        cpp_inject "std::string data_bytes(zero_count, 0);"
        cpp_inject "for (auto b : bytes) data_bytes += (char)b;"
        cpp_inject "if (data_bytes.size() >= 4) {"
        cpp_inject "    std::string payload_str = data_bytes.substr(0, data_bytes.size() - 4);"
        cpp_inject "    unsigned int cksum = 0;"
        cpp_inject "    for (char c : payload_str) cksum += (unsigned char)c;"
        cpp_inject "    unsigned int target_cksum = 0;"
        cpp_inject "    for (size_t i = data_bytes.size() - 4; i < data_bytes.size(); ++i) {"
        cpp_inject "        target_cksum = (target_cksum << 8) | (unsigned char)data_bytes[i];"
        cpp_inject "    }"
        cpp_inject "    if (cksum == target_cksum) res = payload_str;"
        cpp_inject "}"
    return res
