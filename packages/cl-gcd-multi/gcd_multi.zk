// cl-gcd-multi: Multi-argument GCD and LCM Math Engine
import cl-gcd as base_gcd

fn gcd(arr: vector[int]) -> int:
    res := 0
    n := list_size(arr)
    if n > 0:
        res = arr[0]
        for i := 1; i < n; i++:
            res = base_gcd::gcd(res, arr[i])
    return res

fn lcm(arr: vector[int]) -> int:
    res := 0
    n := list_size(arr)
    if n > 0:
        res = arr[0]
        for i := 1; i < n; i++:
            res = base_gcd::lcm(res, arr[i])
    return res
